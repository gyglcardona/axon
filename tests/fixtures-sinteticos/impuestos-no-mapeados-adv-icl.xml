        <cbc:TaxAmount>19000</cbc:TaxAmount>
        <cbc:Percent>19</cbc:Percent>
        <cac:TaxScheme><cbc:ID>01</cbc:ID></cac:TaxScheme>
      </cac:TaxSubtotal>
      <cac:TaxSubtotal>
        <cbc:TaxableAmount>100000</cbc:TaxableAmount>
